{
  "name": "daily-intentions-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Vercel backend API for Daily Intentions app with AI features",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "verify-openai": "tsx scripts/verify-openai.ts",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test tests/*.test.mjs",
    "test:live": "bash test-backend.sh",
    "deploy:parallel": "python3 scripts/deploy-parallel.py",
    "deploy:aws": "sst deploy --stage parallel"
  },
  "keywords": [
    "vercel",
    "serverless",
    "openai",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "openai": "^6.39.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "sst": "4.17.1",
    "tsx": "^4.22.3",
    "typescript": "^5.3.3",
    "vercel": "56.5.0"
  }
}
